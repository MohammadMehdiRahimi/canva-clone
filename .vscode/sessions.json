{
  "$schema": "https://cdn.statically.io/gh/nguyenngoclongdev/cdn/main/schema/v11/terminal-keeper.json",
  "theme": "tribe",
  "active": "default",
  "activateOnStartup": true,
  "keepExistingTerminals": false,
  "sessions": {
    "default": [
      [
        {
          "name": "api-getway",
          "autoExecuteCommands": true,
          "icon": "info",
          "color": "terminal.ansiYellow",
          "commands": [
            "cd apps/server/api-getway"
          ]
        },
        {
          "name": "upload-service",
          "autoExecuteCommands": true,
          "icon": "cloud-upload",
          "color": "terminal.ansiYellow",
          "commands": [
            "cd apps/server/upload-service"
          ]
        },
        {
          "name": "design-service",
          "autoExecuteCommands": true,
          "icon": "debug-stackframe",
          "color": "terminal.ansiYellow",
          "commands": [
            "cd apps/server/design-service"
          ]
        },
        {
          "name": "subscription-service",
          "autoExecuteCommands": true,
          "icon": "person-add",
          "color": "terminal.ansiYellow",
          "commands": [
            "cd apps/server/subscription-service"
          ]
        }
      ],
      [
        {
          "name": "client",
          "autoExecuteCommands": true,
          "icon": "person",
          "color": "terminal.ansiGreen",
          "commands": [
            "cd apps/client"
          ]
        },
        {
          "name": "run client",
          "autoExecuteCommands": true,
          "icon": "person",
          "color": "terminal.ansiGreen",
          "commands": [
            "pnpm run client"
          ]
        },
        {
          "name": "storybook",
          "autoExecuteCommands": false,
          "icon": "notebook",
          "color": "terminal.ansiRed",
          "commands": [
            "pnpm run storybook"
          ]
        }
      ],
      {
        "name": "commit",
        "autoExecuteCommands": false,
        "icon": "git-commit",
        "color": "terminal.ansiBlue",
        "commands": [
          "pnpm run commit"
        ]
      }
    ],
    "saved-session": [
      {
        "name": "connect",
        "commands": [
          ""
        ]
      }
    ]
  }
}