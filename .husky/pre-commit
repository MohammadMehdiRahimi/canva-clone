RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
BOLDER='\033[,8m'
UNDERLINE='\033[4m'
BOLD='\033[1m'
BOLDER='\033[1;2m'
SMALL='\033[2m'
LARGE='\033[1;4m'
RED='\033[0;31m'
RED_BOLD='\033[1;31m'
RED_BOLDER='\033[1;2;31m'
YELLOW_BOLD='\033[1;33m'
GREEN_BOLD='\033[1;32m'
NC='\033[0m'


echo -e "     ${BLUE}🚀 Husky is working ${NC} \n   "

echo -e "${BLUE}checking stage files for console.log ... ${NC} \n";
BAD_FILES=$(git diff --cached --name-only | grep -v "pre-commit"  | xargs -I{} sh -c "git show :{} | grep -n \"console.log\" && echo {}" || true)

if [ -n "$BAD_FILES" ]; then
    echo -e "${RED_BOLDER}${BOLD}=========================================${NC}"
    echo -e "${RED_BOLD}${LARGE}🚫 COMMIT BLOCKED${NC}"
    echo -e "${RED_BOLDER}${BOLD}=========================================${NC}"
    echo -e "${BOLDER}Found console.log in:${NC}"
    echo -e "${YELLOW} $BAD_FILES${NC} \n"
    echo -e "${SMALL}Please remove console.log statements and try again.${NC}"
    exit 1
fi

echo -e "${GREEN} ✅  console.log was not found in the files... ✅ ${NC}"




